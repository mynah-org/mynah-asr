  {
   "type": "timeseries",
   "title": "Slots in use",
   "description": "active / slots. At 1.0 the next stream is refused (503).",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "mynah-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mynah-prometheus"
     },
     "expr": "mynah_asr_fleet_sessions_active / mynah_asr_fleet_slots",
     "legendFormat": "cpu fleet",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mynah-prometheus"
     },
     "expr": "mynah_asr_sessions_active{worker=\"gpu\"}",
     "legendFormat": "gpu (active)",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Model duty per worker",
   "description": "rate(model_busy) / workers_up: the fraction of time the model runs.",
