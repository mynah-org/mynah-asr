  {
   "type": "timeseries",
   "title": "Emission lag p50 / p95",
   "description": "Quantiles for the eye; the alerts count deltas over 320 ms exactly.",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "mynah-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 19
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mynah-prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(mynah_asr_fleet_emission_lag_seconds_bucket[5m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mynah-prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(mynah_asr_fleet_emission_lag_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mynah-prometheus"
     },
     "expr": "rate(mynah_asr_emission_lag_ms_sum{worker=\"gpu\"}[5m]) / rate(mynah_asr_emission_lag_ms_count{worker=\"gpu\"}[5m]) / 1000",
     "legendFormat": "gpu mean",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Deltas 320 ms late or worse (exact)",
   "description": "1 - bucket{le=0.32}/count: counted, not interpolated.",
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "mynah-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 19
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mynah-prometheus"
     },
     "expr": "1 - rate(mynah_asr_fleet_emission_lag_seconds_bucket{le=\"0.32\"}[5m]) / rate(mynah_asr_fleet_emission_lag_seconds_count[5m])",
     "legendFormat": "fraction",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
