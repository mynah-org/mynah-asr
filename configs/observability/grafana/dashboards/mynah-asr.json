{
 "title": "mynah-asr",
 "uid": "mynah-asr",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "tags": [
  "mynah",
  "asr"
 ],
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "10s",
 "timezone": "",
 "panels": [
  {
   "type": "row",
   "title": "Are requests being served?",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Audio served (s of audio per s)",
   "description": "rate(audio_seconds_total): concurrent real-time streams sustained. The throughput unit.",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "mynah-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mynah-prometheus"
     },
     "expr": "rate(mynah_asr_fleet_audio_seconds_total[1m])",
     "legendFormat": "cpu fleet",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mynah-prometheus"
     },
     "expr": "rate(mynah_asr_audio_seconds_total{worker=\"gpu\"}[1m])",
     "legendFormat": "gpu",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Sessions completed / s",
